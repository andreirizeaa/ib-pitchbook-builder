{
  "name": "ai-pitchdeck-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "for port in 8000 8001 8002 8003; do lsof -ti:$port | xargs kill -9 2>/dev/null; done; echo 'Ports cleared'",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.7.0"
  }
}
